{% extends 'base.html.twig' %}

{% block title %}Ticket{% endblock %}

{% block body %}
    <h1>Ticket</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ ticket.id }}</td>
            </tr>
            <tr>
                <th>Subject</th>
                <td>{{ ticket.subject }}</td>
            </tr>
            <tr>
                <th>Message</th>
                <td>{{ ticket.message }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>
                    <span class="badge bg-secondary">{{ ticket.status }}</span>
                    {% for t in workflow_transitions(ticket) %}
                        <form method="post" action="{{ path('app_ticket_transition', {id: ticket.id, transition: t.name}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('transition' ~ ticket.id) }}">
                            <button class="btn btn-sm btn-outline-primary">{{ t.name }}</button>
                        </form>
                    {% endfor %}
                </td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ ticket.createdAt ? ticket.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr><th>Priorité</th><td>{{ ticket.priority ?? '—' }}</td></tr>
            <tr><th>Brouillon IA</th><td>{{ ticket.aiDraft ? ticket.aiDraft|nl2br : 'En attente…' }}</td></tr>
        </tbody>
    </table>

    <a href="{{ path('app_ticket_index') }}">back to list</a>

    <a href="{{ path('app_ticket_edit', {'id': ticket.id}) }}">edit</a>

    {{ include('ticket/_delete_form.html.twig') }}
{% endblock %}
